{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.WyroBase/wyro-check",
  "title": "Wyro",
  "description": "Maps a backend's routes to the tables they reach and flags routes with no auth. No model inside.",
  "websiteUrl": "https://wyro.in",
  "version": "0.2.14",
  "packages": [
    {
      "registryType": "npm",
      "registryBaseUrl": "https://registry.npmjs.org",
      "identifier": "wyro-check",
      "version": "0.2.14",
      "runtimeHint": "npx",
      "transport": { "type": "stdio" },
      "packageArguments": [{ "type": "positional", "value": "--mcp" }]
    }
  ]
}
